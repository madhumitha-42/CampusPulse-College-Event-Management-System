# ==============================================================================
# Django Production & Local Development Environment Variables
# ==============================================================================

# Django Secret Key (Generate a random 50+ character string for production)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Debug Mode: Set to 0 in Production, 1 for Local Development
DJANGO_DEBUG=0

# Allowed Hosts (Comma-separated list of domain names/IPs allowed to serve requests)
# Example: ALLOWED_HOSTS=smart-college-backend.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=*

# CORS & CSRF Trusted Origins (Comma-separated URLs of your deployed frontend)
# Example: CORS_ALLOWED_ORIGINS=https://smart-college.vercel.app,https://smart-college.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Allow all CORS origins (Set to 1 for open API access, 0 to restrict to CORS_ALLOWED_ORIGINS)
CORS_ALLOW_ALL_ORIGINS=0

# Database URL (Optional for production PostgreSQL; defaults to SQLite if omitted)
# Format: postgres://username:password@hostname:5432/database_name
# DATABASE_URL=postgres://user:password@ep-example-12345.postgres.render.com/campuspulse_db